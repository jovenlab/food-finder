# ---------------------------------------------------------------------------
# Food Finder - frontend configuration
#
# WHAT THIS FILE IS
#
#   .env.example  is a TEMPLATE, committed to git, containing no secrets.
#   .env.local    is YOUR copy. It is git-ignored and never committed.
#
# Next.js uses ".env.local" rather than ".env" for local overrides.
#
#     cp .env.example .env.local      (macOS/Linux)
#     copy .env.example .env.local    (Windows)
# ---------------------------------------------------------------------------


# ===== SECURITY NOTE - READ BEFORE ADDING ANYTHING HERE ====================
#
# Any variable whose name starts with NEXT_PUBLIC_ is compiled INTO the
# JavaScript sent to every visitor. It is not hidden, not encrypted, and is
# readable by anyone who opens DevTools.
#
# So: never put a secret in a NEXT_PUBLIC_ variable. No API keys, no database
# URLs, no Stripe secret key. Those all live in backend/.env and stay on the
# server, which is why the browser talks to our backend instead of talking to
# Stripe and Open Food Facts directly.
#
# There is deliberately no Stripe key here at all. The frontend never touches
# Stripe: it asks our backend for a Checkout URL and navigates to it.


# Base URL of the Express backend.
#
# Public by definition - the browser has to know where to send requests, and
# anyone can read it from the network tab anyway.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed so other developers know what is required.

# ---- Server ----
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder"

# Scratch database Prisma uses to validate migrations during development.
SHADOW_DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder_shadow"

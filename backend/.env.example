# ---------------------------------------------------------------------------
# Food Finder - backend configuration
#
# WHAT THIS FILE IS
#
#   .env.example  is a TEMPLATE. It is committed to git, contains no real
#                 secrets, and exists so that anyone cloning this project can
#                 see exactly which settings are needed.
#
#   .env          is YOUR copy, with real values in it. It is git-ignored and
#                 must never be committed. It exists only on your machine.
#
# To get started:  copy this file to .env and fill in the marked values.
#
#     cp .env.example .env      (macOS/Linux)
#     copy .env.example .env    (Windows)
#
# Every variable below is listed, including the optional ones - a setting you
# cannot discover is a setting nobody will use.
# ---------------------------------------------------------------------------


# ===== Server ==============================================================

# Port the Express backend listens on.
# Optional - defaults to 4000.
PORT=4000

# The one origin allowed to call this API from a browser (CORS).
# Optional - defaults to http://localhost:3000.
# Must match where the frontend actually runs, or every request is blocked.
FRONTEND_ORIGIN=http://localhost:3000

# "development" or "production".
# Optional - defaults to development.
# In production, unexpected internal errors are replaced with a generic message
# so that stack traces, file paths and table names never reach a user.
# NODE_ENV=development


# ===== Database (REQUIRED) =================================================

# The only setting the server refuses to start without.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Create the database and this user with backend/db/01-create-database.sql.
DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder"

# A scratch database Prisma creates and drops tables in to verify a migration
# before touching the real one. Used only by `npx prisma migrate dev`, never at
# runtime - the server starts fine without it.
SHADOW_DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder_shadow"


# ===== Open Food Facts =====================================================
#
# No API key exists - the service is free and public. Everything here is
# optional and has a working default.

# Where to send product searches.
# Optional - defaults to https://world.openfoodfacts.org.
# Point this at a local mock server to develop or test without the real API.
# OFF_BASE_URL=https://world.openfoodfacts.org

# Open Food Facts asks every application to identify itself, and blocks generic
# clients. Optional, but please put something recognisable here if you deploy.
# OFF_USER_AGENT="FoodFinder/1.0 (student assignment; https://example.com)"

# How long to wait for a reply, in milliseconds.
# Optional - defaults to 25000. Measured real responses take 3-20 seconds, so a
# short timeout fails constantly against a service that is merely slow.
# OFF_TIMEOUT_MS=25000

# How many products to request per search.
# Optional - defaults to 20.
# OFF_PAGE_SIZE=20


# ===== Stripe (TEST MODE ONLY) =============================================
#
# All three are optional: leave them blank and the application still runs, with
# subscribing disabled. Anything that needs Stripe then fails with a clear
# message naming the variable to set, rather than a confusing crash.
#
# A LIVE key (sk_live_...) is REJECTED at startup on purpose. This project must
# never touch real money.
#
# Get these with the dashboard's "Test mode" toggle switched ON.

# Secret key: https://dashboard.stripe.com/test/apikeys
# SERVER-SIDE ONLY. This can create charges and read customer data - it must
# never reach the browser, and must never be given a NEXT_PUBLIC_ name.
STRIPE_SECRET_KEY=

# The monthly recurring price the demo user subscribes to.
# Create a product at https://dashboard.stripe.com/test/products with a price
# billed every 1 month, then copy the PRICE id (price_...), not the product id
# (prod_...). Verify it with: npm run stripe:check
STRIPE_PRICE_ID=

# Signing secret, used to prove an incoming webhook really came from Stripe.
# Without it the webhook endpoint refuses every request - which is correct: an
# unverified webhook endpoint is a free-subscription button.
#
# Printed when you run:
#     stripe listen --forward-to localhost:4000/stripe/webhook
#
# It changes every time you restart `stripe listen`, so expect to update this.
STRIPE_WEBHOOK_SECRET=

# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed so other developers know what is required.

# ---- Server ----
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# ---- Database ----
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder"

# Scratch database Prisma uses to validate migrations during development.
SHADOW_DATABASE_URL="mysql://food_finder_app:YOUR_PASSWORD_HERE@localhost:3306/food_finder_shadow"

# ---- Stripe (TEST MODE ONLY) ----
# Get these from https://dashboard.stripe.com/test/apikeys - make sure the
# dashboard's "Test mode" toggle is ON. A live key (sk_live_...) is REJECTED at
# startup on purpose: this project must never touch real money.
#
# Leave these blank and the application still runs; only subscribing is disabled.

# Secret key. Server-side only - never expose this to the browser.
STRIPE_SECRET_KEY=

# The monthly recurring price the demo user subscribes to.
# Create a product at https://dashboard.stripe.com/test/products with a
# recurring price billed every 1 month, then copy its price id.
STRIPE_PRICE_ID=

# Signing secret used to prove an incoming webhook really came from Stripe.
# Printed when you run:
#   stripe listen --forward-to localhost:4000/stripe/webhook
STRIPE_WEBHOOK_SECRET=
